(define (problem cake_completion-0)
    (:domain omnigibson)

    (:objects
        chocolate_cake.n.01_1 - chocolate_cake.n.01
        casserole.n.02_1 - casserole.n.02
        cream__carton.n.01_1 - cream__carton.n.01
        chocolate_bar.n.01_1 - chocolate_bar.n.01
        plate.n.04_1 - plate.n.04
        dishtowel.n.01_1 - dishtowel.n.01
        oven.n.01_1 - oven.n.01
        electric_refrigerator.n.01_1 - electric_refrigerator.n.01
        countertop.n.01_1 - countertop.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop chocolate_cake.n.01_1 casserole.n.02_1)
        (inside casserole.n.02_1 oven.n.01_1)
        (inside cream__carton.n.01_1 electric_refrigerator.n.01_1)
        (ontop chocolate_bar.n.01_1 countertop.n.01_1)
        (ontop plate.n.04_1 countertop.n.01_1)
        (ontop dishtowel.n.01_1 countertop.n.01_1)
        (not (open oven.n.01_1))
        (not (open electric_refrigerator.n.01_1))
        (inroom oven.n.01_1 kitchen)
        (inroom electric_refrigerator.n.01_1 kitchen)
        (inroom countertop.n.01_1 kitchen)
        (inroom floor.n.01_1 kitchen)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (ontop casserole.n.02_1 countertop.n.01_1)
        )
    )
)
