(define (problem draw_a_line_on_paper-0)
    (:domain omnigibson)

    (:objects
        ; Drawing tools
        pen.n.01_1 - pen.n.01
        rule.n.12_1 - rule.n.12
        sheet.n.02_1 - sheet.n.02

        ; Ink (future particle system — created by DRAW action)
        ink.n.01_1 - ink.n.01

        ; Heavy objects (can stabilize the ruler)
        textbook.n.01_1 - textbook.n.01
        stapler.n.01_1 - stapler.n.01
        mug.n.04_1 - mug.n.04

        ; Light objects (too light to stabilize the ruler)
        rubber_eraser.n.01_1 - rubber_eraser.n.01
        pencil.n.01_1 - pencil.n.01
        dixie_cup.n.01_1 - dixie_cup.n.01

        ; Scene furniture
        countertop.n.01_1 - countertop.n.01
        wall.n.01_1 - wall.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        ; All objects on the countertop
        (ontop sheet.n.02_1 countertop.n.01_1)
        (ontop pen.n.01_1 countertop.n.01_1)
        (ontop rule.n.12_1 countertop.n.01_1)
        (ontop textbook.n.01_1 countertop.n.01_1)
        (ontop stapler.n.01_1 countertop.n.01_1)
        (ontop mug.n.04_1 countertop.n.01_1)
        (ontop rubber_eraser.n.01_1 countertop.n.01_1)
        (ontop pencil.n.01_1 countertop.n.01_1)
        (ontop dixie_cup.n.01_1 countertop.n.01_1)

        ; Ink is created at runtime by drawing
        (future ink.n.01_1)

        ; Room assignments
        (inroom countertop.n.01_1 kitchen)
        (inroom wall.n.01_1 kitchen)
        (inroom floor.n.01_1 kitchen)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            (real ink.n.01_1)
            (covered sheet.n.02_1 ink.n.01_1)
        )
    )
)
