(define (problem heat_frozen_pancake_and_set_table-0)
    (:domain omnigibson)

    (:objects
        buttermilk_pancake.n.01_1 - buttermilk_pancake.n.01
        bottle__of__maple_syrup.n.01_1 - bottle__of__maple_syrup.n.01
        plate.n.04_1 - plate.n.04
        cabinet.n.01_1 - cabinet.n.01
        electric_refrigerator.n.01_1 - electric_refrigerator.n.01
        microwave.n.02_1 - microwave.n.02
        stove.n.01_1 - stove.n.01
        frying_pan.n.01_1 - frying_pan.n.01
        breakfast_table.n.01_1 - breakfast_table.n.01
        straight_chair.n.01_1 - straight_chair.n.01
        soup_ladle.n.01_1 - soup_ladle.n.01
        shelf.n.01_1 - shelf.n.01
        countertop.n.01_1 - countertop.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        ; Pancake is frozen inside the fridge
        (inside buttermilk_pancake.n.01_1 electric_refrigerator.n.01_1)
        (frozen buttermilk_pancake.n.01_1)

        ; Syrup bottle is on the high shelf (not directly reachable)
        (ontop bottle__of__maple_syrup.n.01_1 shelf.n.01_1)

        ; Plate is inside the cabinet (must open cabinet first)
        (inside plate.n.04_1 cabinet.n.01_1)

        ; NOTE: Stove is broken and shelf is high — these are HIDDEN constraints
        ; applied programmatically by _apply_custom_object_states() in run_llm_agent.py,
        ; not expressed in BDDL, so the agent must discover them through trial and error.

        ; Frying pan is on the stove
        (ontop frying_pan.n.01_1 stove.n.01_1)

        ; Soup ladle is on countertop
        (ontop soup_ladle.n.01_1 countertop.n.01_1)

        ; Chair is next to table (movable)
        (nextto straight_chair.n.01_1 breakfast_table.n.01_1)

        ; Room assignments
        (inroom electric_refrigerator.n.01_1 kitchen)
        (inroom microwave.n.02_1 kitchen)
        (inroom stove.n.01_1 kitchen)
        (inroom countertop.n.01_1 kitchen)
        (inroom cabinet.n.01_1 kitchen)
        (inroom shelf.n.01_1 kitchen)
        (inroom breakfast_table.n.01_1 kitchen)
        (inroom floor.n.01_1 kitchen)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
            ; Pancake must be cooked (heated via stove+frying pan)
            (cooked buttermilk_pancake.n.01_1)
            ; Pancake is on the plate
            (ontop buttermilk_pancake.n.01_1 plate.n.04_1)
            ; Plate is on the dining table
            (ontop plate.n.04_1 breakfast_table.n.01_1)
            ; Syrup bottle is also on the dining table
            (ontop bottle__of__maple_syrup.n.01_1 breakfast_table.n.01_1)
        )
    )
)
