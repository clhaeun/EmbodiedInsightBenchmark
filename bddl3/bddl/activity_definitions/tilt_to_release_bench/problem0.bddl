(define (problem tilt_to_release_bench-0)
    (:domain omnigibson)

    (:objects
        cedar_chest.n.01_1 - cedar_chest.n.01
        necklace.n.01_1 - necklace.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop cedar_chest.n.01_1 floor.n.01_1)
        (inside necklace.n.01_1 cedar_chest.n.01_1)
        (inroom cedar_chest.n.01_1 living_room)
        (inroom floor.n.01_1 living_room)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal (not (inside necklace.n.01_1 cedar_chest.n.01_1)))
)
